# Solo en el servidor /opt/lp/.env.production, nunca subirlo al repositorio.
POSTGRES_DB=lp
POSTGRES_USER=lp
# 3 contraseñas distintas, generar cada una con: openssl rand -hex 32
POSTGRES_PASSWORD=REEMPLAZAR_CLAVE_ADMIN
APP_DB_PASSWORD=REEMPLAZAR_CLAVE_APP
AUTH_DB_PASSWORD=REEMPLAZAR_CLAVE_AUTH
NEXT_PUBLIC_SITE_URL=https://169.58.121.198

# Opcional: SMTP propio del hosting; sin SMTP, solo cuentas bootstrap de administración.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Opcional: facturación Stripe. No activar cobros sin webhook verificado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUSINESS=

# Inicio con Google: crear credenciales OAuth 2.0 de aplicación web.
# IMPORTANTE: sustituir NEXT_PUBLIC_SITE_URL por un dominio HTTPS propio,
# p. ej. https://app.midominio.com (no la IP pública).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Inicio con Apple: requiere dominio HTTPS propio y cuenta Apple Developer.
# Configurar un Services ID asociado a un App ID, Team ID, Key ID y clave .p8.
# La clave privada se guarda SOLO en .env.production, codificada en base64.
APPLE_OAUTH_SERVICE_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY_B64=
